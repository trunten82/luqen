<section aria-label="Audit log">
  <h1 class="section-title">{{t "audit.title"}}</h1>
  <p class="text-muted">{{total}} entries found</p>

  <form method="GET" action="/admin/audit-log" class="admin-section" aria-label="Audit log filters">
    <div class="filter-bar filter-bar--wrap">
      <div class="form-group">
        <label for="filter-actor" class="form-label">{{t "audit.actor"}}</label>
        <input type="text" id="filter-actor" name="actor" class="input input--sm" value="{{filters.actor}}" placeholder="Username">
      </div>
      <div class="form-group">
        <label for="filter-action" class="form-label">{{t "audit.action"}}</label>
        <select id="filter-action" name="action" class="select select--sm">
          <option value=""{{#unless filters.action}} selected{{/unless}}>{{t "audit.allActions"}}</option>
          {{#each actionOptions}}
          <option value="{{value}}"{{#if selected}} selected{{/if}}>{{#if labelKey}}{{t labelKey}}{{else}}{{label}}{{/if}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group">
        <label for="filter-resource-type" class="form-label">{{t "audit.resourceType"}}</label>
        <select id="filter-resource-type" name="resourceType" class="select select--sm">
          <option value=""{{#unless filters.resourceType}} selected{{/unless}}>{{t "audit.allResources"}}</option>
          {{#each resourceTypeOptions}}
          <option value="{{value}}"{{#if selected}} selected{{/if}}>{{#if labelKey}}{{t labelKey}}{{else}}{{label}}{{/if}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group">
        <label for="filter-from" class="form-label">{{t "common.from"}}</label>
        <input type="date" id="filter-from" name="from" class="input input--sm" value="{{filters.from}}">
      </div>
      <div class="form-group">
        <label for="filter-to" class="form-label">{{t "common.to"}}</label>
        <input type="date" id="filter-to" name="to" class="input input--sm" value="{{filters.to}}">
      </div>
      <div class="form-group">
        <button type="submit" class="btn btn--primary btn--sm">{{t "common.filter"}}</button>
        <a href="/admin/audit-log" class="btn btn--ghost btn--sm">{{t "common.reset"}}</a>
      </div>
    </div>
  </form>

  <div class="table-wrapper" role="region" aria-label="Audit log entries" tabindex="0">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">{{t "audit.timestamp"}}</th>
          <th scope="col">{{t "audit.actor"}}</th>
          <th scope="col">{{t "audit.action"}}</th>
          <th scope="col">{{t "audit.resourceType"}}</th>
          <th scope="col">{{t "audit.resourceId"}}</th>
          <th scope="col">{{t "audit.details"}}</th>
          <th scope="col">{{t "audit.ipAddress"}}</th>
          <th scope="col">{{t "audit.org"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each entries}}
        <tr>
          <td data-label="Timestamp"><code>{{this.timestamp}}</code></td>
          <td data-label="Actor">{{this.actorLabel}}</td>
          <td data-label="Action"><span class="badge badge--neutral">{{this.action}}</span></td>
          <td data-label="Resource Type">{{this.resourceType}}</td>
          <td data-label="Resource ID">{{this.resourceId}}</td>
          <td data-label="Details">{{this.details}}</td>
          <td data-label="IP Address"><code>{{this.ipAddress}}</code></td>
          <td data-label="Org">{{#if this.orgId}}{{this.orgId}}{{else}}{{t "common.systemNoOrg"}}{{/if}}</td>
        </tr>
        {{else}}
        <tr>
          <td colspan="8" class="text-center text-muted">{{t "audit.noEntries"}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{#if hasMore}}
  <div class="load-more">
    <a href="/admin/audit-log?actor={{filters.actor}}&action={{filters.action}}&resourceType={{filters.resourceType}}&from={{filters.from}}&to={{filters.to}}&limit={{limit}}&offset={{nextOffset}}"
       class="btn btn--ghost btn--full">
      {{t "audit.loadMore"}}
    </a>
  </div>
  {{/if}}
</section>
